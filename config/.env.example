# ============================================================
# TraderJP — .env configuration
# Copy this file to .env (project root) and fill in your values.
# NEVER commit your .env file to git.
# ============================================================


# ---- Tradovate Credentials ------------------------------------
# Your Tradovate LOGIN EMAIL — the email address you used to register.
# This is NOT your Apex account ID (e.g. APEX_261113 is WRONG).
# Use the same email you log in with at trader.tradovate.com
TRADOVATE_USERNAME=you@example.com
TRADOVATE_PASSWORD=your_tradovate_password

# Unique ID for this machine/instance (any string; auto-generated if blank)
TRADOVATE_DEVICE_ID=TraderJP-device-001

# API credentials — get these from tradovate.com → Settings → API Access
# For personal use without a registered app, leave CID=0 and SECRET blank.
TRADOVATE_CID=0
TRADOVATE_SECRET=

# LIVE = true → real money account  |  false → demo/sim account
# Set to false first to test!
TRADOVATE_LIVE=true

# (Optional) Specific Apex account name, e.g. APX12345
# Leave blank to use the first account on your login.
TRADOVATE_ACCOUNT_NAME=


# ---- TradingView Webhook Secret --------------------------------
# A strong random string you create. MUST match the "secret" field
# in your TradingView alert messages.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=change_me_to_a_long_random_string

# Server address (0.0.0.0 = listen on all interfaces)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000


# ---- Apex Trader Funding Account Rules -------------------------
# Set these to match YOUR Apex account limits exactly.
# Wrong limits = potential rule violation.

# Your account size (informational only)
APEX_ACCOUNT_SIZE=100000

# Maximum daily loss in dollars (from account balance + open P&L)
# Examples:
#   $25k account  → 1500
#   $50k account  → 2500
#   $100k account → 3000
#   $150k account → 4500
#   $250k account → 6500
APEX_DAILY_LOSS_LIMIT=3000

# Maximum trailing drawdown in dollars (from equity peak)
# Same typical values as daily loss limit for evaluation accounts.
APEX_MAX_TRAILING_DRAWDOWN=3000

# Profit target to pass evaluation (informational — bot does NOT stop at target)
APEX_PROFIT_TARGET=6000

# Max simultaneous contracts (Apex limits by account size)
# $25k→2, $50k→4, $100k→6, $150k→8, $250k→14
APEX_MAX_CONTRACTS=6

# Consistency rule: single day cannot exceed this % of cumulative profit
APEX_CONSISTENCY_RULE=true
APEX_MAX_DAY_PROFIT_PCT=0.30

# Flatten all positions N minutes before RTH close (0 = disabled)
# Recommended: 5 to avoid end-of-day slippage
APEX_EOD_FLATTEN_MINUTES=5

# Warn when daily loss hits this fraction of the limit (80% = $2,400 on $3k limit)
APEX_WARNING_THRESHOLD=0.80


# ---- Contract Settings ----------------------------------------
# Base futures symbol (ES = E-mini S&P 500)
SYMBOL=ES

# Default contract quantity when TradingView alert doesn't specify
DEFAULT_QTY=1


# ---- Session Filter -------------------------------------------
# RTH = Regular Trading Hours (08:30–15:15 CT / 09:30–16:15 ET)  ← recommended
# ETH = Extended/Globex hours (everything outside RTH)
TRADE_RTH=true
TRADE_ETH=false

# Optional hard time window override (CT, 24h format, e.g. "09:00" and "14:30")
# Leave blank to use session defaults above.
FORCE_START=
FORCE_END=


# ---- News Filter ----------------------------------------------
NEWS_FILTER_ENABLED=true

# Minutes to block trading BEFORE a high-impact event
NEWS_BLACKOUT_BEFORE_MIN=10

# Minutes to block trading AFTER a high-impact event
NEWS_BLACKOUT_AFTER_MIN=5

# Impact levels to block: High | Medium | Low  (comma-separated)
NEWS_IMPACTS=High

# Countries to watch (comma-separated ISO codes)
NEWS_COUNTRIES=USD


# ---- Order Flow Autonomous Trading ----------------------------
# Set ORDER_FLOW_ENABLED=true to let the bot generate its own entry signals
# from live Tradovate DOM + trade prints (no TradingView alerts required).
# All session, news, and risk filters still apply.
# Exits are manual — use /flatten or the webhook close action to exit.

ORDER_FLOW_ENABLED=false

# Contracts per entry
ORDER_FLOW_QTY=1

# Bid:ask imbalance ratio needed to trigger a signal (e.g. 3.0 = 3:1)
# Higher = fewer but stronger signals.  Typical range: 2.5 – 5.0
ORDER_FLOW_IMBALANCE_RATIO=3.0

# Minimum rolling cumulative delta (in contracts) to confirm the signal.
# Positive = net buying pressure confirms LONG; negative confirms SHORT.
ORDER_FLOW_DELTA_MIN=50

# Number of recent trade prints to include in the rolling delta window.
ORDER_FLOW_DELTA_LOOKBACK=30

# A single trade print this size (contracts) is flagged as a "large print".
# Large prints are logged for context but do NOT trigger entries alone.
ORDER_FLOW_LARGE_PRINT=100

# How many price levels (from best bid/ask) to include in imbalance calc.
ORDER_FLOW_DOM_LEVELS=5

# Minimum seconds between entries (prevents rapid re-entry on sustained imbalance).
ORDER_FLOW_COOLDOWN=30

# Stop loss per trade in dollars — placed immediately after every entry.
# $300 = 6 ES points (6 × $50/pt).  Must be a multiple of $12.50 (1 tick).
ORDER_FLOW_STOP_DOLLARS=300

# Take profit per trade in dollars — placed immediately after every entry.
# Default $600 = 12 ES points → 2:1 reward-to-risk vs the $300 stop.
ORDER_FLOW_TP_DOLLARS=600

# Daily profit cap — bot stops opening new trades once session P&L hits this.
# Realized + open P&L is checked before every signal.  0 = no cap.
ORDER_FLOW_DAILY_CAP=1000


# ---- Risk Monitor ---------------------------------------------
# How often (seconds) to poll Tradovate for P&L and enforce limits
RISK_POLL_INTERVAL=10


# ---- Logging --------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/traderjp.log
